{
  "name": "snapcontext-vscode",
  "displayName": "SnapContext",
  "description": "Asistente de IA con contexto automático para desarrollo: chat, planificador y selección inteligente de archivos.",
  "version": "3.2.0",
  "publisher": "NicolasBrunaFuentealbaIsaias",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai", "gemini", "claude", "ollama", "aider", "agente", "mcp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snapcontext.abrirChat",
        "title": "Abrir chat",
        "category": "SnapContext"
      },
      {
        "command": "snapcontext.ejecutarConsulta",
        "title": "Ejecutar consulta",
        "category": "SnapContext"
      },
      {
        "command": "snapcontext.planificar",
        "title": "Planificar",
        "category": "SnapContext"
      },
      {
        "command": "snapcontext.configurarApiKey",
        "title": "Configurar API key",
        "category": "SnapContext"
      },
      {
        "command": "snapcontext.limpiarSeleccion",
        "title": "Limpiar archivos seleccionados",
        "category": "SnapContext"
      },
      {
        "command": "snapcontext.anadirAlContexto",
        "title": "Añadir al contexto",
        "category": "SnapContext"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "snapcontext.anadirAlContexto",
          "title": "SnapContext: Añadir al contexto",
          "group": "snapcontext"
        }
      ],
      "commandPalette": [
        { "command": "snapcontext.anadirAlContexto", "when": "false" },
        { "command": "snapcontext.limpiarSeleccion", "when": "snapcontext.tieneSeleccion" }
      ]
    },
    "configuration": {
      "title": "SnapContext",
      "properties": {
        "snapcontext.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Ruta al ejecutable de Python donde está instalado snapcontext."
        },
        "snapcontext.provider": {
          "type": "string",
          "enum": [null, "gemini", "anthropic", "ollama", "deepseek", "groq"],
          "default": null,
          "description": "Proveedor de IA por defecto (equivalente a --provider)."
        },
        "snapcontext.apiKey": {
          "type": "string",
          "default": "",
          "description": "Clave API del proveedor (se pasa como variable de entorno GEMINI_API_KEY/ANTHROPIC_API_KEY según el proveedor)."
        },
        "snapcontext.confirmar": {
          "type": "boolean",
          "default": true,
          "description": "Pedir confirmación antes de acciones sensibles (--confirmar/--no-confirmar)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
